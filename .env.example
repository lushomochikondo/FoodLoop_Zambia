# Example only. Copy desired values into .env for local use, or configure the hosting dashboard.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-new-random-secret
DJANGO_ALLOWED_HOSTS=your-hostname.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-hostname.example
POSTGRES_DB=foodloop
POSTGRES_USER=foodloop
POSTGRES_PASSWORD=replace-with-the-database-password
POSTGRES_HOST=your-database-hostname
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
DJANGO_MEDIA_ROOT=/data/media
# Enable only behind your selected host's trusted HTTPS reverse proxy.
DJANGO_TRUST_PROXY=0
REQUEST_EXPIRY_HOURS=24
MEAL_WEIGHT_KG=0.4
PORT=8000
# Optional email notifications. Disabled until explicitly configured and enabled.
EMAIL_NOTIFICATIONS_ENABLED=0
EMAIL_HOST=your-smtp-host
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-secret
DEFAULT_FROM_EMAIL=foodloop@your-domain.example
PUBLIC_APP_URL=
# Optional sourced environmental estimate. Leave both blank until agreed.
CO2E_KG_PER_KG=
CO2E_SOURCE=

# Optional browser push. Generate a VAPID keypair; keep the private key secret.
WEB_PUSH_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_PRIVATE_KEY=path-to-vapid-private-pem-or-pem-value
WEB_PUSH_SUBJECT=mailto:admin@your-domain.example
# SRS v1.3 operational settings; adjust via Django Administration > Platform settings.
REOFFER_GROUP_SIZE=5
HANDOVER_CODE_ATTEMPTS=5
LITRE_TO_KG_FACTOR=1
WEIGHT_SANITY_LIMIT_KG=100000
MATCH_WEIGHT_LOCATION=30
MATCH_WEIGHT_URGENCY=30
MATCH_WEIGHT_QUANTITY=20
MATCH_WEIGHT_CONDITION=20
# Set pathway value estimates only after they are agreed; blank values are shown as not configured.
IMPACT_VALUE_PER_KG_HUMAN=
IMPACT_VALUE_PER_KG_FEED=
IMPACT_VALUE_PER_KG_COMPOST=

REOFFER_HALF_TIME_FRACTION=0.5
MEAL_WEIGHT_KG=0.4
